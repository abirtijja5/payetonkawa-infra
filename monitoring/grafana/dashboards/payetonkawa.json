      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job, view) (rate(django_http_requests_total_by_view_transport_method_total[5m]))",
          "legendFormat": "{{job}} · {{view}}"
        }
      ]
    },
