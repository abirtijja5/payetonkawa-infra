{
  "uid": "payetonkawa",
  "title": "PayeTonKawa - Supervision des API",
  "schemaVersion": 39,
  "version": 2,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "tags": [
    "payetonkawa"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Instances en ligne",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(up{job=~\"client|product|order\"})"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Appels HTTP (1 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(django_http_requests_total_by_view_transport_method_total[1h]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Erreurs 5xx (1 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(increase(django_http_responses_total_by_status_total{status=~\"5..\"}[1h]))) or vector(0)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Exceptions (1 h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(increase(django_http_exceptions_total_by_type_total[1h]))) or vector(0)"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Temps moyen d'un appel",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(django_http_requests_latency_seconds_by_view_method_sum[5m])) / sum(rate(django_http_requests_latency_seconds_by_view_method_count[5m]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Messages en attente (broker)",
      "datasource": {
        "type": "prometheus",
